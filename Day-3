#include<stdio.h>
int main()
{
    int r,c,i,j;
    scanf("%d",&r,&c);
    int a[r][c];
    for(i=0;i<r;i++)
    {
       for(j=0;j<c;j++)
       scanf("%d",&a[i][j]); 
    }
    printf("The output is");
    for(i=0;i<r;i++,printf("\n"))
    {
       for(j=0;j<c;j++)
       printf("%d",a[i][j]); 
    }
   
}
