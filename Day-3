//Patterns

//Pattern base1

#include<stdio.h>
int main()
{
    int n,r,c;
    scanf("%d",&n);
    for(r=0;r<n;r++,printf("\n"))
    {
        for(c=0;c<n;c++,printf(" "))
        printf("*");
    }
    
}

