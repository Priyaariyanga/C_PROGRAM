    // ==========================================
    // 15. Find Prime Numbers
    // ==========================================
    
        #include<stdio.h>
        int main()
        {
            int i,n,c=0;
            scanf("%d",&n);
            if(n==1)
            {
                printf("Neither prime nor composite number");
                return 0;
            }
            for(i=2;i<=n/2;i++)
            {
                if(n%i==0)
                {c++;
                printf("Not a prime number");
                break;}
            }
            if(c==0)
             printf("Prime Number");
        }
                                                                                                                                       

    // ==========================================
    // 16. Count the Number of Digits
    // ==========================================
        #include<stdio.h>
        int main()
        {
            int n,c=0;
            scanf("%d",&n);
            while(n!=0)
            {
                n=n/10;
                c++;
            }
            printf("%d",c);
        }
                                                                                                                                       

    // ==========================================
    // 17. Sum of the Digits of a Given Number
    // ==========================================

        #include<stdio.h>
        int main()
        {
            int n,sum=0,d;
            scanf("%d",&n);
            while(n!=0)
            {
                d=n%10;
                sum=sum+d;
                n=n/10;
            }
            printf("%d",sum);
            return 0;
       } 
    

  
