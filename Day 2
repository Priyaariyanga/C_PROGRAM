    // 1. Two Numbers Equal or Not
    // ==========================================
#include <stdio.h>
int main() 
    {
        int a, b;
        printf("Enter two numbers: ");
        scanf("%d%d", &a, &b);
        if (a == b)
            printf("Equal\n");
        else
            printf("Not Equal\n");
    }

    // ==========================================
    // 2. Positive, Negative, or Zero
    // ==========================================
#include <stdio.h>
int main() 
    {
        int a;
        printf("Enter a number: ");
        scanf("%d", &a);
        if (a > 0)
            printf("Number is %d: Positive\n", a);
        else if (a < 0)
            printf("Number is %d: Negative\n", a);
        else
            printf("Number is 0\n");
    }

